# Optional: enables LLM-powered, scope-limited chatbot responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Used for sessions and production configuration.
SECRET_KEY=change-me-in-production
# Admin dashboard credentials. Configure both as encrypted FastAPI Cloud secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ENVIRONMENT=development
# Local default is SQLite. In FastAPI Cloud, configure this as a secret PostgreSQL URL.
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=sqlite:///./codeshadow.db
